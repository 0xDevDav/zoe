# Copy this file to ~/.zoe/.env, outside the source tree. Everything personal lives
# under ZOE_HOME (~/.zoe by default): this file, the database with the neuron graph,
# the vault and its key, and the owner's workspace. Set ZOE_HOME in the real
# environment if you move it.

# Telegram bot token from @BotFather (use a separate test bot first).
# It can live in the vault instead: zoe-vault set telegram bot_token --kind token
ZOE_BOT_TOKEN=

# The owner's Telegram user ids, space or comma separated. Several ids are
# several accounts of the same person. Nobody else gets an answer until the
# owner lets them in, from the menu or by asking Zoe.
ZOE_OWNER_IDS=
ZOE_OWNER_NAME=

# Public profile, applied at every start when it differs: name, and a profile
# photo (ZOE_HOME/avatar.png when that file exists, Zoe's own otherwise).
ZOE_BOT_NAME=Zoe
ZOE_BOT_PHOTO=

# Parallel turns. Messages of the same chat are always handled one at a time.
ZOE_WORKERS=3

# Starting language for new chats: it or en.
ZOE_DEFAULT_LANG=en

# The owner's working directory, where Claude reads CLAUDE.md (defaults to ZOE_HOME/workspace).
ZOE_WORKDIR=
# Vault key as an environment value instead of ZOE_HOME/vault.key (recommended in production).
ZOE_VAULT_KEY=

# Claude.
ZOE_CLAUDE_BIN=claude
ZOE_CLAUDE_MODEL=claude-opus-5-5

# A turn is stopped after this many seconds total, or after this many with no output.
ZOE_CLAUDE_TIMEOUT=1800
ZOE_CLAUDE_INACTIVITY_TIMEOUT=240
# A turn answers at once even while its background tasks (a wait, a render) run on; they
# are followed for at most this many seconds, and what Claude says when they end is sent too.
ZOE_CLAUDE_BACKGROUND_TIMEOUT=14400

# How many times a stuck or failed message is retried before it is set aside.
ZOE_MAX_ATTEMPTS=2

# Parallel minds: how many work at once, the seconds a run may take in total and
# without any output before it is stopped, and the free memory a new one needs.
ZOE_MINDS=2
ZOE_MIND_TIMEOUT=14400
ZOE_MIND_INACTIVITY_TIMEOUT=1800
ZOE_MIND_MIN_FREE_MB=1024

# Days a received file is kept before it is deleted, unless Zoe keeps it for good.
ZOE_TEMP_FILE_DAYS=7

# The menu, a Telegram Mini App: its public HTTPS address, which a reverse proxy forwards
# to 127.0.0.1:ZOE_MENU_PORT, since Telegram opens Mini Apps only over HTTPS. Without an
# address there is no menu. It has Zoe's own look; ZOE_HOME/menu/theme.css replaces it when that exists.
ZOE_MENU_URL=
ZOE_MENU_PORT=8791

# The observer: the model that reads finished conversations, and how many seconds
# a conversation must be quiet before it reads it (it also reads every 30 messages).
ZOE_OBSERVER_MODEL=claude-sonnet-5-5
ZOE_OBSERVER_IDLE=600

# The nightly review of memory and the nightly study that proposes improvements, as cron rules.
ZOE_REVIEW_AT=0 3 * * *
ZOE_IMPROVE_AT=30 3 * * *

# Speech in: the Whisper server (python -m zoe.whisper_server). Leave the URL empty to disable.
ZOE_WHISPER_URL=http://127.0.0.1:8790
ZOE_GLOSSARY_CHARS=700
ZOE_WHISPER_HOST=127.0.0.1
ZOE_WHISPER_PORT=8790
ZOE_WHISPER_MODEL=large-v3-turbo
ZOE_WHISPER_DEVICE=cpu
ZOE_WHISPER_COMPUTE=int8

# Speech out: ElevenLabs. The API key goes in the vault:
#   zoe-vault set elevenlabs api_key --kind api_key
ZOE_ELEVENLABS_VOICE_ID=
ZOE_ELEVENLABS_MODEL=eleven_v4
ZOE_TTS_MAX_CHARS=1500
# How the voice says some words: a file of "Word = how to say it" lines (default ZOE_HOME/pronunciation.txt).
ZOE_PRONUNCIATION=

ZOE_POLL_TIMEOUT=50
ZOE_LOG_LEVEL=INFO
